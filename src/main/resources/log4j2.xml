<?xml version="1.0" encoding="UTF-8"?>
<Configuration status="WARN">
    <Appenders>
        <Console name="Console" target="SYSTEM_OUT">
            <PatternLayout pattern="%d{yyyy-MM-dd HH:mm:ss} [%t] %-5level %logger{36} - %msg%n"/>
        </Console>
    </Appenders>
    <Loggers>
        <!-- Nivel INFO para el código de la aplicación -->
        <Logger name="com.clinica.turnos" level="INFO" additivity="false">
            <AppenderRef ref="Console"/>
        </Logger>
        <!-- Nivel WARN para dependencias externas -->
        <Root level="WARN">
            <AppenderRef ref="Console"/>
        </Root>
    </Loggers>
</Configuration>
